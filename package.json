{
  "name": "seoul-bd-dental",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "node scripts/fetch-youtube.cjs && vite build && node scripts/post-build.cjs",
    "build:fast": "vite build && node scripts/post-build.cjs",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name seoul-bd-dental",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "queue:build": "python3 scripts/column-queue.py",
    "queue:seed": "python3 scripts/seed-queue.py",
    "queue:seed:local": "wrangler d1 execute bdbddc-production --local --file=/home/user/gsc-work/seed-column-queue.sql",
    "queue:seed:prod": "wrangler d1 execute bdbddc-production --remote --file=/home/user/gsc-work/seed-column-queue.sql",
    "gate:parity": "esbuild src/column-gate.ts --bundle --format=esm --outfile=/tmp/gate.mjs --log-level=error && node scripts/gate-parity.mjs",
    "cron:deploy": "wrangler deploy -c scripts/cron-worker/wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.18.2",
    "clean-css-cli": "^5.6.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "wrangler": "^4.106.0"
  }
}
