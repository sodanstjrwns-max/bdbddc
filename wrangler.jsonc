{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoul-bd-dental",
  "compatibility_date": "2025-12-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // v5.50 컬럼 썸네일 런타임 생성 (Workers AI). 크레딧 대신 계정 무료 할당 사용.
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "bdbddc-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bdbddc-production",
      "database_id": "bc30460e-c27f-43db-8644-2e3450f43b8d"
    }
  ]
}